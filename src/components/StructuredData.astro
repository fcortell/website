---
import { SITE } from "@/config";

type Props =
  | {
      type: "BlogPosting";
      data: {
        title: string;
        description: string;
        author: string;
        pubDatetime: Date;
        modDatetime?: Date | null;
        url: string;
        ogImage?: string;
        tags: string[];
        wordCount: number;
      };
    }
  | { type: "Person" | "WebSite" };

const siteURL = new URL(SITE.website);
const person = {
  "@type": "Person",
  name: SITE.author,
  url: new URL("/about", siteURL).href,
};

let structuredData: Record<string, unknown>;

if (Astro.props.type === "BlogPosting") {
  const { data } = Astro.props;
  structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    author: data.author === SITE.author ? person : { "@type": "Person", name: data.author },
    datePublished: data.pubDatetime.toISOString(),
    dateModified: (data.modDatetime ?? data.pubDatetime).toISOString(),
    publisher: person,
    mainEntityOfPage: { "@type": "WebPage", "@id": data.url },
    image: data.ogImage ?? new URL(SITE.ogImage, siteURL).href,
    keywords: data.tags.join(", "),
    wordCount: data.wordCount,
  };
} else if (Astro.props.type === "Person") {
  structuredData = {
    "@context": "https://schema.org",
    ...person,
    image: new URL(SITE.ogImage, siteURL).href,
    sameAs: [
      "https://github.com/fcortell",
      "https://twitter.com/fcortell",
      "https://bsky.app/profile/fcortell.com",
    ],
    jobTitle: "Software Engineer",
    description: "Full stack software developer turned outdoorsman.",
  };
} else {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.title,
    url: siteURL.href,
    description: "Full stack software developer turned outdoorsman.",
    author: person,
    potentialAction: {
      "@type": "SearchAction",
      target: new URL("/search?q={search_term_string}", siteURL).href,
      "query-input": "required name=search_term_string",
    },
  };
}
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
